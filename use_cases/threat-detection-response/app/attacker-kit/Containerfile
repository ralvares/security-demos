# Attacker kit — runs on the presenter's laptop with podman (scripts/attacker.sh).
# The cluster sees the attacker as an external IP, like a real breach.
#   payload server: serves stage.sh + the fake xmrig   (attacker-kit serve)
#   mining pool:    fake stratum pool                  (attacker-kit pool)
#   c2:             reverse-shell listener             (busybox nc)
ARG GO_IMAGE=docker.io/library/golang:1.27.4-alpine3.24
ARG BASE_IMAGE=docker.io/library/alpine:3.24.4

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY xmrig ./xmrig
COPY server ./server
RUN cd xmrig  && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/xmrig . && \
    cd ../server && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/attacker-kit .

FROM ${BASE_IMAGE}
RUN apk upgrade --no-cache
COPY --from=build /out/xmrig /opt/kit/xmrig
COPY --from=build /out/attacker-kit /usr/local/bin/attacker-kit
USER 1001
ENTRYPOINT ["/usr/local/bin/attacker-kit"]
CMD ["serve"]
